# ============================================================
# Forcepoint DLP Protector - Inspection API connection settings
# ============================================================
#
# Single Protector (the simple case): use the PROTECTOR_* vars below as-is.
#
# Multiple Protectors: instead use numbered PROTECTOR_1_*, PROTECTOR_2_*, ...
# (same field names, just prefixed with a number) and set PROTECTOR_DEFAULT to
# whichever number should be used when a scan doesn't specify one. Example:
#
#   PROTECTOR_1_NAME=Production
#   PROTECTOR_1_HOST=10.20.4.10
#   PROTECTOR_1_PORT=8080
#   PROTECTOR_1_PROTOCOL=http
#
#   PROTECTOR_2_NAME=Staging
#   PROTECTOR_2_HOST=10.20.5.10
#   PROTECTOR_2_PORT=8080
#   PROTECTOR_2_PROTOCOL=http
#
#   PROTECTOR_DEFAULT=1
#
# Optional per-Protector: keep an entry configured but hide it from selection and
# block scans to it (e.g. its Inspection API isn't licensed/enabled on the appliance
# yet). It reappears automatically once you flip PROTECTOR_N_DISABLED back to false.
#
#   PROTECTOR_2_DISABLED=true
#   PROTECTOR_2_UNAVAILABLE_REASON=Pending Inspection API license activation
#
# ---------------------------------------------------------------------------
# Sending to the Protector over HTTPS
# ---------------------------------------------------------------------------
# The Inspection API is served over BOTH schemes on the same appliance - http on
# 8080 and https on 8443 - so PROTECTOR_N_PROTOCOL only sets the DEFAULT. The
# "HTTP/HTTPS" toggle on the Scan page overrides it per request, and these two
# vars let each scheme keep its own port (defaults 8080 / 8443):
#
#   PROTECTOR_1_HTTP_PORT=8080
#   PROTECTOR_1_HTTPS_PORT=8443
#
# TLS trust. Protector certificates are issued by the appliance's own CA, so that
# CA has to be trusted explicitly - point this at its PEM:
#
#   PROTECTOR_1_CA_CERT_PATH=./certs/protector-ca.crt
#
# Those certificates are typically issued to a hostname and carry NO
# subjectAltName, while this app usually connects by IP. That combination fails
# with ERR_TLS_CERT_ALTNAME_INVALID even when the chain is perfectly valid. Set
# this to the name on the certificate to verify against it instead of the connect
# address (this does not need to resolve in DNS):
#
#   PROTECTOR_1_TLS_SERVERNAME=protector.example.internal
#
# Last resort - skips certificate verification entirely (the equivalent of curl's
# -k, which the Forcepoint docs suggest). Prefer the CA + servername pair above;
# only use this if you cannot obtain the issuing CA:
#
#   PROTECTOR_1_TLS_REJECT_UNAUTHORIZED=false
#
# When PROTECTOR_1_HOST (or higher) is set, the numbered format takes over
# entirely and the plain PROTECTOR_* vars below are ignored - don't mix the two.
# The UI shows a "Send to Protector" picker so you can choose per scan; the API
# never exposes host/port/token to the browser, only the id + name you set here.

# Hostname or IP of the Forcepoint Protector appliance
PROTECTOR_HOST=protector.example.local

# Protocol: http or https
PROTECTOR_PROTOCOL=http

# Port: default 8080 for http, 8443 for https
PROTECTOR_PORT=8080

# Optional bearer token. Leave empty to omit the Authorization header entirely.
PROTECTOR_TOKEN=

# Optional path to a CA certificate file (PEM) used to validate the Protector's
# TLS certificate when PROTECTOR_PROTOCOL=https. Leave empty if not using HTTPS,
# or if you intend to disable certificate validation via PROTECTOR_TLS_REJECT_UNAUTHORIZED.
PROTECTOR_CA_CERT_PATH=

# Whether to validate the Protector's TLS certificate (https only).
# Set to false to allow self-signed certificates without a CA file (equivalent to curl -k).
# Default: true
PROTECTOR_TLS_REJECT_UNAUTHORIZED=true

# ============================================================
# Request limits / behavior
# ============================================================

# Maximum accepted file size in MB (Protector's own limit is typically 30MB)
MAX_FILE_SIZE_MB=30

# Timeout (ms) for the request to the Protector
REQUEST_TIMEOUT_MS=30000

# ============================================================
# Metadata sent to the Protector
# ============================================================

# Note: source.host_ips and source.host_name are configurable at runtime via the
# Settings screen in the UI (not here) - see README.

# Value sent as destinations[0].http_request_url. Required by some Protector
# deployments for policy/URL-category resolution even though this client has no
# real destination URL of its own.
DESTINATION_HTTP_URL=https://dlp-client.local/upload

# Value sent as destinations[0].http_request_url_hostname (hostname portion of the URL above)
DESTINATION_HTTP_HOSTNAME=dlp-client.local

# ============================================================
# Local web server / logging
# ============================================================

# Port the Node/Express server listens on (this app, not the Protector)
PORT=3000

# Path to the JSON-lines request log file
LOG_FILE_PATH=./logs/requests.log.jsonl

# ============================================================
# HTTPS for this app's own web UI / API
# ============================================================
# Off by default (plain HTTP on PORT above). Set SERVER_HTTPS_ENABLED=true to serve
# the UI and API over TLS instead - the app then listens with TLS on PORT, and there
# is no plaintext listener at all unless HTTP_REDIRECT_PORT is also set.
#
# Note this is unrelated to PROTECTOR_*_PROTOCOL, which controls how this app talks
# OUT to a Protector appliance. This section is about how browsers reach this app.
#
# The certificate must be PEM. If your CA issues intermediates, either append them to
# the cert file (leaf first, then intermediates) or point SERVER_TLS_CA_PATH at the
# chain. Make sure the certificate's Subject Alternative Name covers every hostname
# or IP users will actually type - browsers ignore the Common Name entirely.
SERVER_HTTPS_ENABLED=false
SERVER_TLS_CERT_PATH=./certs/server.crt
SERVER_TLS_KEY_PATH=./certs/server.key

# Optional: CA / intermediate chain to present alongside the certificate.
SERVER_TLS_CA_PATH=

# Optional: only if the private key file is encrypted.
SERVER_TLS_PASSPHRASE=

# Optional: run a tiny plaintext listener on this port that does nothing but 301
# redirect to the https:// URL, so old http:// bookmarks still work. Leave empty
# to serve HTTPS only, with no plaintext port open at all.
HTTP_REDIRECT_PORT=

# ---------------------------------------------------------------------------
# Key Phrase Redaction (POST /api/sanitize)
# ---------------------------------------------------------------------------
# Optional, additive workflow layered on top of the existing Forcepoint integration:
# inspect -> if MATCHED, redact the configured Key Phrases for the violated rule(s)
# -> re-inspect -> only ever return content Forcepoint has verified as clean.
#
# Leave unset to leave this feature off entirely (the rest of the app is unaffected).
# If set, the file must be present and structurally valid, or the app refuses to
# start - see config/key-phrases.example.json for the format and src/keyPhraseConfig.js
# for the full validation rules.
KEY_PHRASE_CONFIG_PATH=

# ---------------------------------------------------------------------------
# Semantic AI DLP (Milestone 1 - Shadow Mode)
# ---------------------------------------------------------------------------
# Optional, additive layer that classifies scanned content by MEANING (via a local
# Ollama model), independently of Forcepoint's own rules - see
# docs/semantic-dlp-architecture.md. Runs alongside the existing Forcepoint scan on
# POST /api/scan and adds an additive `aiAnalysis` field to that response; it never
# changes a scan's resolution/actions (shadow mode only - AI_DLP_MODE=shadow is the
# only supported value in this milestone).
#
# Off by default. With AI_DLP_ENABLED=false (or unset), none of this code runs at
# all and the rest of the app is completely unaffected.
AI_DLP_ENABLED=false
AI_DLP_MODE=shadow

# Requires a local Ollama server (https://ollama.com) already running with the
# model below pulled (`ollama pull qwen3:8b`). Never exposed to the browser - only
# this backend talks to Ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Milliseconds to wait for one classification call. A real measurement on a
# CPU-only dev machine (no GPU) with qwen3:4b took 38s-157s for a single small
# chunk - keep this generous unless you have a GPU or a much smaller model.
OLLAMA_TIMEOUT=240000

# These four are the actual, measured fix for a real reliability problem: without
# them, this hardware/model combination measured a ~50% timeout rate (open-ended
# generation, no cap). keep_alive avoids reloading the model between scans;
# num_ctx/num_predict bound the work per call - together with the maxLength/
# maxItems bounds already in the response schema (src/semanticScanner.js), which
# are what actually force a complete, valid response inside this budget, not
# num_predict alone. With all of this, the same cases that used to time out
# completed in 66-95s with zero timeouts. See src/config.js for the full story.
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=150
OLLAMA_TEMPERATURE=0

# Chunking (characters, not tokens) - see docs/semantic-dlp-architecture.md,
# "Bounded Large-Content Processing". Chunks are classified sequentially
# (concurrency 1), never in parallel.
AI_CHUNK_SIZE=4000
AI_CHUNK_OVERLAP=200

# Content beyond this many characters is truncated before analysis even starts
# (always reported in the result as `truncated: true`, never silent).
AI_MAX_CONTENT_SIZE=40000
